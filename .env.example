# LearnGap AI - Environment Variables
# Connect to your Supabase project (replace with your credentials from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Redis Middleman Buffer & Rate Limiter (Optional - Upstash, Redis Cloud, or Docker)
# If left blank, LearnGap AI automatically falls back to high-performance in-memory Redis (fakeredis).
REDIS_URL=redis://localhost:6379/0

